eometry"/></mxCell><mxCell id="c24" value="high-Z" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="424" width="120" height="20" as="geometry"/></mxCell><mxCell id="c25" value="high-Z" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1238" y="424" width="120" height="20" as="geometry"/></mxCell><mxCell id="c26" value="tCES 120 ns (&amp;gt;= 5)" style="rounded=0;html=1;endArrow=open;startArrow=open;endSize=5;startSize=5;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="520" as="sourcePoint"/><mxPoint x="248" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="TRANSFER W -&amp;gt; R&lt;br&gt;+20 ns" style="rounded=0;html=1;endArrow=open;startArrow=open;endSize=5;startSize=5;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="428" y="560" as="sourcePoint"/><mxPoint x="448" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="tCHH 100 (&amp;gt;= 5)" style="rounded=0;html=1;endArrow=open;startArrow=open;endSize=5;startSize=5;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1192" y="520" as="sourcePoint"/><mxPoint x="1232" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="tCEH 70 (&amp;gt;= 5)" style="rounded=0;html=1;endArrow=open;startArrow=open;endSize=5;startSize=5;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1204" y="560" as="sourcePoint"/><mxPoint x="1232" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="CS low 2580 ns (8 + 32 SCK, tCYC 60 ns &amp;gt;= 50)" style="rounded=0;html=1;endArrow=open;startArrow=open;endSize=5;startSize=5;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="610" as="sourcePoint"/><mxPoint x="1232" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="8 SCK: opcode" style="rounded=0;html=1;endArrow=open;startArrow=open;endSize=5;startSize=5;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="248" y="660" as="sourcePoint"/><mxPoint x="440" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="32 SCK: DB3 DB2 DB1 DB0 -&amp;gt; sense[31:0]" style="rounded=0;html=1;endArrow=open;startArrow=open;endSize=5;startSize=5;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="448" y="660" as="sourcePoint"/><mxPoint x="1204" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;MISO örnekleme&lt;/b&gt;&lt;br&gt;SO, SCK düşen kenarından t_DV (&amp;lt;= 20 ns) sonra değişir. Core MISO'yu SCK yükselen kenarından 1 clk (10 ns) sonra, yani düşen kenar + 40 ns'de örnekler. Pencere: SO değişimi &amp;lt; 40 ns (tarama: 39 ns doğru, 40 ns hatalı). Kart + FPGA I/O bütçesi 20 ns. Testler T_SO = 5 ve 35 ns köşelerinde." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="560" height="130" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Paket (launch -&amp;gt; SYNC 2760 ns)&lt;/b&gt;&lt;br&gt;2002 CONFIG clk_div, 2100 CONFIG mode 0, 2208 word length 8, 11FE CS aktif, 0100 TRANSFER W 1 kelime (opcode), 0203 TRANSFER R 4 kelime, 11FF CS pasif, 30nn SYNC id.&lt;br&gt;Arka arkaya okuma aralığı 2800 ns (~357 kHz); iki paket arası nCS high &amp;gt;= 210 ns (tCPH &amp;gt;= 55)." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="560" height="130" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Diğer paketler&lt;/b&gt;&lt;br&gt;yazma 1 byte (02/04/1E): 0101, 1300 ns, CS 1120&lt;br&gt;yazma 2 byte (3A/3C, DB1 = hyst, DB0 = center): 0102, 1780 ns, CS 1600&lt;br&gt;okuma 1 byte (82/84/9E): 0100 0200, 1320 ns&lt;br&gt;okuma 2 byte (BA/BC): 0100 0201, 1800 ns" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="700" width="510" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page6" name="6 - Init politikasi"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Init politikası (INIT_EVERY_START = false, varsayılan)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Driver entegreye son yazdığı ve geri okumayla doğruladığı ayarları shadow register'larda tutar (init_done = cfg_done). start'ta karar:" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1500" height="22" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;IDLE: start / self_test_req&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;ayarlar latch&amp;#x27;lenir&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="240" height="60" as="geometry"/></mxCell><mxCell id="c4" value="eşik kodları&lt;br&gt;geçerli?" style="rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="220" width="160" height="100" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Reddedilir&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;err = 1, kod 1 (CFG_RANGE)&lt;br&gt;SPI trafiği yok&lt;br&gt;init_done değişmez&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="INIT_EVERY_START&lt;br&gt;ya da&lt;br&gt;init_done = 0?" style="rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="210" width="190" height="120" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;TAM INIT&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;nMR 200 ns + 1 us (HAS_MR)&lt;br&gt;02 04 3A 3C 1E yaz&lt;br&gt;82 84 BA BC 9E geri oku&lt;br&gt;settle 2 us&lt;br&gt;start -&amp;gt; veri ~ 19,3 us&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="270" height="140" as="geometry"/></mxCell><mxCell id="c8" value="ayarlar son&lt;br&gt;yazılandan&lt;br&gt;farklı?" style="rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="210" width="180" height="120" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;KISMİ GÜNCELLEME (nMR yok)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;yalnız değişen: 04 / 3A / 3C yaz&lt;br&gt;84 / BA / BC geri oku&lt;br&gt;settle 2 us&lt;br&gt;start -&amp;gt; veri 6,2-6,7 us (tek)&lt;br&gt;12,8 us (üçü)&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="400" width="280" height="140" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;DOĞRUDAN OKUMA&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;yazma yok, nMR yok&lt;br&gt;start -&amp;gt; veri ~ 2,8 us&lt;br&gt;hysteresis latch&amp;#x27;leri korunur&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="220" width="240" height="100" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;F8 okuma(lar) / self-test&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;sense, sense_valid, sense_chg, sense_act&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="640" width="380" height="70" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="hayır" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="270"/></Array></mxGeometry></mxCell><mxCell id="c14" value="evet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="evet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="hayır" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="evet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="hayır" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="init_done = 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="515" y="675"/></Array></mxGeometry></mxCell><mxCell id="c20" value="init_done = 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.6579;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.2083;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="675"/></Array></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;init_done = 0 olur&lt;/b&gt; (sonraki start tam init yapar):&lt;br&gt;- rst_n&lt;br&gt;- yapısal hata 8 / 9 / A / B&lt;br&gt;- geri okuma hatası (kod 2), ERR_LIMIT ile durma&lt;br&gt;- periyodik doğrulama uyuşmazlığı (kod 3, POR)&lt;br&gt;- self-test hatası (kod 4)&lt;br&gt;- bir yazma dizisi başlarken (yarıda kesilirse içerik bilinmez)&lt;br&gt;Kısmi güncelleme geri okuması tutmazsa: tam init ile yeniden denenir." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="350" width="420" height="220" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Periyodik doğrulama (VERIFY_EVERY = 16)&lt;/b&gt;&lt;br&gt;Her 16 F8 okumada bir, okumadan hemen sonra 82 84 BA BC 9E geri okunur. Eşik register'ları her turda var: geçerli eşik asla 0x00 değil, POR / besleme kesintisi kesin yakalanır. Sayaç start'lar arasında sürer (tek okuma kullanımında da çalışır). Uyuşmazlık: kod 3, init_done = 0, hemen tam init. Tespit gecikmesi &amp;lt;= 16 okuma (T28: 13, 2, 16 okuma; tek okumada 12. start). VERIFY_EVERY = 0: POR fark edilmez." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="590" width="420" height="200" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;DS-10&lt;/b&gt;: nMR'ın hysteresis latch'ine etkisi datasheet'te açık değil (model: 0x00). Politika ile nMR yalnız açılışta ve hata sonrasında verilir; normal kullanımda band içindeki kanallar durumunu korur (T24). INIT_EVERY_START = true: her start'ta nMR + tam init (eski davranış)." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="900" height="90" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Açıklama&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="800" width="250" height="170" as="geometry"/></mxCell><mxCell id="c26" value="bizim RTL (HI8436)" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="830" width="230" height="22" as="geometry"/></mxCell><mxCell id="c27" value="ortak core (common/rtl/async)" style="rounded=0;fillColor=#b0e3e6;strokeColor=#0e8088;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="858" width="230" height="22" as="geometry"/></mxCell><mxCell id="c28" value="dış dünya / bu işin dışı" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="886" width="230" height="22" as="geometry"/></mxCell><mxCell id="c29" value="FSM durumu" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="970" y="914" width="230" height="22" as="geometry"/></mxCell><mxCell id="c30" value='&lt;font color="#b85450"&gt;- - - &amp;gt;  reset yolu&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="974" y="940" width="220" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
