d, err" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="405" width="170" height="34" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="395"/></Array></mxGeometry></mxCell><mxCell id="c23" value="req/gnt + cmd/sdo/sdi/sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c11"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="165"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.4167;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.7778;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="395"/><mxPoint x="1100" y="340"/></Array></mxGeometry></mxCell><mxCell id="c26" value="tek paket&lt;br&gt;akışı" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="SCK / MOSI / MISO&lt;br&gt;nCS (CS_IDX)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.15;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry x="0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="540"/><mxPoint x="1190" y="540"/></Array></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c14"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="560"/><mxPoint x="1380" y="560"/></Array></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.85;exitY=1.0;exitDx=0;exitDy=0;entryX=0.625;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c15"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;Bu çalışmanın kapsamı&lt;/b&gt;&lt;br&gt;hi8436_drv + hi8436_top (tek entegre). Kartta iki HI-8436 var: sistem seviyesinde iki instance. Paylaşılan hat için driver'ın req/gnt arayüzü hazır; arbiter henüz yazılmadı (top'ta gnt = '1'). Datasheet SCK/SI/SO ortak, nCS ayrı bağlantıyı önerir (s.14 Fig 9)." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="520" height="130" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Driver arayüzü (düz sinyal)&lt;/b&gt;&lt;br&gt;giriş: start, stop, continuous, period_us, bank_mode, go/so center+hyst, self_test_req&lt;br&gt;çıkış: sense[31:0] (kalıcı), sense_valid (1 clk), sense_chg, sense_act, cfg_done, busy, err, err_code, st_done, st_fail" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="520" height="120" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Açıklama&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="250" height="170" as="geometry"/></mxCell><mxCell id="c33" value="bizim RTL (HI8436)" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="230" height="22" as="geometry"/></mxCell><mxCell id="c34" value="ortak core (common/rtl/async)" style="rounded=0;fillColor=#b0e3e6;strokeColor=#0e8088;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="678" width="230" height="22" as="geometry"/></mxCell><mxCell id="c35" value="dış dünya / bu işin dışı" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="230" height="22" as="geometry"/></mxCell><mxCell id="c36" value="FSM durumu" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="734" width="230" height="22" as="geometry"/></mxCell><mxCell id="c37" value='&lt;font color="#b85450"&gt;- - - &amp;gt;  reset yolu&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="44" y="760" width="220" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2 - hi8436_top"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="hi8436_top: HI-8436 okuma bloğu (driver + SPI master)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="1 driver -&gt; 1 spi_exec -&gt; 1 HI-8436, arbiter yok (gnt = '1'). 100 MHz tek clock. CLK_DIV = 2 (SCLK 16,67 MHz &lt;= 20 MHz), CS_T = 1, DATA_WIDTH = 8 (8..32), SDI_DELAY = 0, Mode 0." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1500" height="22" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Sistem tarafı&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;(sequencer,&lt;br&gt;clk ile senkron)&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="170" height="680" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;hi8436_top&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="1060" height="830" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;u_drv : hi8436_drv&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Control FSM (p_ctrl)&lt;br&gt;Paket tanımı (p_dsc)&lt;br&gt;Packer (p_pack, p_cmd)&lt;br&gt;Timer&amp;#x27;lar: settle 2 us, period, SYNC timeout 10 us, nMR&lt;br&gt;Init politikası: init_done + shadow (sh_*)&lt;br&gt;Periyodik doğrulama (VERIFY_EVERY = 16)&lt;br&gt;Çıkış register&amp;#x27;ı (p_out)&lt;br&gt;&lt;br&gt;gnt = &amp;#x27;1&amp;#x27; (sabit), req kullanılmaz&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="320" height="420" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;u_spi : spi_exec  (SPI master)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;common/rtl/async (dokunulmadı)&lt;br&gt;async reset, ECHO_SCLK = 0&lt;br&gt;&lt;br&gt;NUM_OF_CS = 1, DATA_WIDTH&lt;br&gt;DEFAULT_SPI_CFG = 0 (Mode 0)&lt;br&gt;DEFAULT_CLK_DIV = CLK_DIV&lt;br&gt;NUM_OF_SDI = 1, SDO_DEFAULT = &amp;quot;0&amp;quot;&lt;br&gt;SDI_DELAY generic&lt;br&gt;&lt;br&gt;sdi_data_ready = &amp;#x27;1&amp;#x27;, sync_ready = &amp;#x27;1&amp;#x27;&lt;br&gt;açık: sdo_t, three_wire&lt;/font&gt;' style="rounded=0;fillColor=#b0e3e6;strokeColor=#0e8088;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="320" height="380" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Ayar kaynağı (generate)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;CFG_FROM_GENERIC = false: portlar&lt;br&gt;true: DEF_* generic&amp;#x27;leri&lt;br&gt;(0000, GO 9/5, SO 35/15)&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="640" width="320" height="120" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;p_core_resetn (flop)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;rst_n = &amp;#x27;0&amp;#x27; -&amp;gt; core_resetn = &amp;#x27;0&amp;#x27; (async)&lt;br&gt;aksi: core_resetn &amp;lt;= not core_rst&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#b85450;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="660" width="280" height="100" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;HI-8436&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;32 kanal GND/Open - Supply/Open&lt;br&gt;SPI Mode 0, &amp;lt;= 20 MHz&lt;br&gt;SO yalnız okuma byte&amp;#x27;larında sürülür&lt;br&gt;nMR: dahili pull-up&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#d79b00;strokeWidth=3;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="160" width="240" height="330" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Reset synchronizer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;async assert, sync deassert&lt;br&gt;PLL lock&amp;#x27;a bağlı&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="220" height="80" as="geometry"/></mxCell><mxCell id="c11" value="start, stop, continuous&lt;br&gt;period_us[15:0], self_test_req" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.1029;exitDx=0;exitDy=0;entryX=0.0;entryY=0.0952;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="sense[31:0], sense_valid&lt;br&gt;sense_chg, sense_act" style="edgeStyle=orthogonalEdgeStyle;rounded=0;ht