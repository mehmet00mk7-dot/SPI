<mxfile host="app.diagrams.net" agent="gen_drawio.py" type="device"><diagram id="page1" name="1 - Sistem zinciri"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Sistem zinciri: CPU'suz FADEC sensör okuma (Microchip PolarFire)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Board test tarafı driver'ları düz sinyallerle sürer (start, stop, ayarlar); sonuç düz sinyal olarak döner (valid pulse + veri, kalıcı register). Driver'lar AXI değildir. Kalın çerçeve = bu çalışma (HI8436)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1500" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;UART Master&lt;/b&gt;" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="150" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Interconnect 1&lt;/b&gt;" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="150" width="150" height="90" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Sequencer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;start / stop / ayarlar&lt;br&gt;sonuçları toplar&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="150" width="150" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Interconnect 2&lt;/b&gt;" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="150" width="150" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Bu repo: Driver -&amp;gt; Arbiter -&amp;gt; SPI Master&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="90" width="870" height="400" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;ad7923_drv&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;(önceki iş, AD7923/)&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="240" height="70" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;hi8436_drv  #1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;HI8436/rtl (bu iş)&lt;br&gt;init / doğrulama / F8 okuma / self-test&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="230" width="240" height="90" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;hi8436_drv  #2&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;aynı RTL, ikinci instance&lt;br&gt;(kartta iki HI-8436)&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="350" width="240" height="90" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Arbiter (planlı)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;req / gnt, paket bitene&lt;br&gt;(SYNC) kadar gnt tutulur&lt;br&gt;&lt;br&gt;bugün: her top&amp;#x27;ta&lt;br&gt;gnt = &amp;#x27;1&amp;#x27;&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="200" width="190" height="180" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;SPI Master&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;spi_exec&lt;br&gt;(common/rtl/async)&lt;br&gt;ADI spi_engine_execution&lt;br&gt;VHDL çevirisi&lt;/font&gt;' style="rounded=0;fillColor=#b0e3e6;strokeColor=#0e8088;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="200" width="200" height="180" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;AD7923&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;4 kanal ADC&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="600" width="160" height="90" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;HI-8436 #1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;32 discrete giriş&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#d79b00;strokeWidth=3;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="600" width="160" height="90" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;HI-8436 #2&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;32 discrete giriş&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#d79b00;strokeWidth=3;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><m