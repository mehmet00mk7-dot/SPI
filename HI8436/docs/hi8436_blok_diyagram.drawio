le=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.1579;exitDx=0;exitDy=0;entryX=0.0;entryY=0.1212;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="spi_mosi (SI)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.3421;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="spi_cs_n (nCS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.5263;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5455;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="spi_miso (SO)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.0;exitY=0.7576;exitDx=0;exitDy=0;entryX=1.0;entryY=0.7105;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c6"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="spi_mr_n (nMR, HAS_MR)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.9524;exitDx=0;exitDy=0;entryX=0.0;entryY=0.9091;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry x="-0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="540"/><mxPoint x="1400" y="460"/></Array></mxGeometry></mxCell><mxCell id="c27" value="rst_n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;strokeColor=#b85450;dashed=1;fontColor=#b85450;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.9048;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c5"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="850"/><mxPoint x="390" y="520"/></Array></mxGeometry></mxCell><mxCell id="c28" value="rst_n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;strokeColor=#b85450;dashed=1;fontColor=#b85450;exitX=1.0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c8"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="890"/></Array></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Açıklama&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="520" width="250" height="170" as="geometry"/></mxCell><mxCell id="c30" value="bizim RTL (HI8436)" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="550" width="230" height="22" as="geometry"/></mxCell><mxCell id="c31" value="ortak core (common/rtl/async)" style="rounded=0;fillColor=#b0e3e6;strokeColor=#0e8088;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="578" width="230" height="22" as="geometry"/></mxCell><mxCell id="c32" value="dış dünya / bu işin dışı" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="606" width="230" height="22" as="geometry"/></mxCell><mxCell id="c33" value="FSM durumu" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470" y="634" width="230" height="22" as="geometry"/></mxCell><mxCell id="c34" value='&lt;font color="#b85450"&gt;- - - &amp;gt;  reset yolu&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1474" y="660" width="220" height="20" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Reset stratejisi&lt;/b&gt;&lt;br&gt;Async reset olarak yalnız rst_n. u_drv rst_n'yi doğrudan alır; core'un resetn'i p_core_resetn flop'undan (rst_n ile async clear, D = not core_rst). rst_n düşünce clock beklemeden çıkışlar reset değerinde, spi_cs_n = '1', spi_mr_n = '1'." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="710" width="270" height="140" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Flop kontrolü&lt;/b&gt;: 100 grup / 505 bit, hepsi rst_n'den async reset; düz posedge clk 0." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="870" width="270" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3 - hi8436_drv"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="hi8436_drv: iç bloklar" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Bütün register'lar rst_n ile async reset'li. Soft clear'lar (settle: yazma SYNC'i, period: okuma launch'ı, core_rst) senkron mantık." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Kontrol girişleri&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;start, stop, continuous&lt;br&gt;period_us[15:0]&lt;br&gt;bank_mode[3:0]&lt;br&gt;go/so_center, go/so_hyst&lt;br&gt;self_test_req&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="180" height="170" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Ayar latch + shadow&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;start&amp;#x27;ta: bm_r, goc_r, goh_r, soc_r, soh_r&lt;br&gt;doğrulanan: sh_bm, sh_goc .. sh_soh&lt;br&gt;d_bm / d_go / d_so (fark)&lt;br&gt;start_ok = thr_ok (s.7 Tbl 6)&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="300" height="170" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Control FSM (p_ctrl)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;IDLE, MR_PULSE, MR_WAIT, CFG_WR, CFG_RD,&lt;br&gt;SETTLE, TEST, READ, PERIOD, CORE_RST&lt;br&gt;&lt;br&gt;init_done (= cfg_done), upd[4:0]&lt;br&gt;err, err_code, err_cnt (ERR_LIMIT)&lt;br&gt;st_pend, st_bad, st_fail, rd_owed&lt;br&gt;rd_cnt (VERIFY_EVERY), vfy, rb_bad&lt;br&gt;stop_pend, mr_n_r, core_rst_r&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontS