<mxfile host="app.diagrams.net" agent="gen_drawio.py" type="device"><diagram id="page1" name="1 - ad7923_top"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="ad7923_top: AD7923 okuma bloğu (driver + kanal register'ları + SPI master)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="1 driver -&gt; 1 spi_exec -&gt; 1 AD7923, arbiter yok (gnt = '1'). 100 MHz tek clock. Generic'ler: CLK_DIV = 2 (SCLK = 100 MHz / (2 x (CLK_DIV + 1)) = 16,7 MHz), CS_T = 1." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Sistem tarafı&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;(FPGA fabric,&lt;br&gt;clk ile senkron)&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="170" height="640" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;ad7923_top&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="1060" height="830" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;u_drv : ad7923_drv&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Control FSM (p_ctrl)&lt;br&gt;Timer&amp;#x27;lar: cycle 5 us, power-up 1 us,&lt;br&gt;SYNC timeout 10 us, period&lt;br&gt;Channel selector&lt;br&gt;Command packer (p_pack)&lt;br&gt;Expectation FIFO (p_fifo)&lt;br&gt;RX checker + output register (p_out)&lt;br&gt;&lt;br&gt;gnt = &amp;#x27;1&amp;#x27; (sabit), req kullanılmaz&lt;/font&gt;' style="rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="320" height="380" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;u_spi : spi_exec  (SPI master)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;ADI spi_engine_execution VHDL çevirisi&lt;br&gt;async reset, ECHO_SCLK = 0&lt;br&gt;&lt;br&gt;NUM_OF_CS = 1, DATA_WIDTH = 16&lt;br&gt;DEFAULT_SPI_CFG = 2 (Mode 2)&lt;br&gt;DEFAULT_CLK_DIV = CLK_DIV&lt;br&gt;NUM_OF_SDI = 1, SDO_DEFAULT = &amp;quot;1&amp;quot;&lt;br&gt;SDI_DELAY = &amp;quot;00&amp;quot;&lt;br&gt;&lt;br&gt;sabit girişler: sdi_data_ready = &amp;#x27;1&amp;#x27;,&lt;br&gt;sync_ready = &amp;#x27;1&amp;#x27;, echo_sclk = &amp;#x27;0&amp;#x27;&lt;br&gt;açık çıkışlar: sdo_t, three_wire&lt;/font&gt;' style="rounded=0;fillColor=#b0e3e6;strokeColor=#0e8088;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="320" height="380" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;u_regs : ad7923_ch_regs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;p_regs: kanal başına sonuç register&amp;#x27;ları&lt;br&gt;chN_data / chN_valid / scan_done&lt;br&gt;data_valid -&amp;gt; chN_valid: 1 clk&lt;/font&gt;' style="rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="640" width="320" height="150" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;p_core_resetn (flop)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;rst_n = &amp;#x27;0&amp;#x27; -&amp;gt; core_resetn = &amp;#x27;0&amp;#x27; (async)&lt;br&gt;aksi: core_resetn &amp;lt;= not core_rst&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#b85450;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="660" width="280" height="100" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;AD7923&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;4 kanal, 12 bit, 200 kSPS SAR ADC&lt;br&gt;SPI Mode 2 (CPOL = 1, CPHA = 0)&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="160" width="240" height="300" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Reset synchronizer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;async assert, sync deassert&lt;br&gt;PLL lock&amp;#x27;a bağlı&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="220" height="80" as="geometry"/></mxCell><mxCell id="c11" value="start, stop, continuous&lt;br&gt;ch_mask[3:0], period_us[15:0]&lt;br&gt;range_sel, coding_sel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.1406;exitDx=0;exitDy=0;entryX=0.0;entryY=0.1579;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="busy, err" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.3438;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c3"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="data_valid, data_ch[1:0]&lt;br&gt;data[11:0]" 