i_mosi (DIN)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.3421;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3667;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="spi_cs_n (cs(0))" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.5263;exitDx=0;exitDy=0;entryX=0.0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="spi_miso (DOUT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.0;exitY=0.8333;exitDx=0;exitDy=0;entryX=1.0;entryY=0.7105;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c6"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="rst_n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;strokeColor=#b85450;dashed=1;fontColor=#b85450;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.9474;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c5"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="850"/><mxPoint x="390" y="500"/></Array></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;strokeColor=#b85450;dashed=1;fontColor=#b85450;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c7"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="870"/><mxPoint x="405" y="760"/></Array></mxGeometry></mxCell><mxCell id="c28" value="rst_n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;strokeColor=#b85450;dashed=1;fontColor=#b85450;exitX=1.0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c8"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="890"/></Array></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Açıklama&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="490" width="250" height="170" as="geometry"/></mxCell><mxCell id="c30" value="bizim RTL: register / process" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="516" width="230" height="22" as="geometry"/></mxCell><mxCell id="c31" value="bizim RTL: kombinasyonel" style="rounded=1;arcSize=6;fillColor=#fff5e6;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="540" width="230" height="22" as="geometry"/></mxCell><mxCell id="c32" value="ortak core (common/rtl/async)" style="rounded=0;fillColor=#b0e3e6;strokeColor=#0e8088;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="564" width="230" height="22" as="geometry"/></mxCell><mxCell id="c33" value="dış blok / dış dünya" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="588" width="230" height="22" as="geometry"/></mxCell><mxCell id="c34" value="FSM durumu" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470" y="612" width="230" height="22" as="geometry"/></mxCell><mxCell id="c35" value='&lt;font color="#b85450"&gt;- - - &amp;gt;  reset yolu&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1474" y="636" width="220" height="20" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Reset stratejisi&lt;/b&gt;&lt;br&gt;Async reset olarak yalnız rst_n kullanılır. u_drv ve u_regs rst_n'yi doğrudan alır; core'un resetn'i p_core_resetn flop'undan gelir (rst_n ile async assert, core_rst ile bir clock gecikmeli ve senkron). rst_n düşünce clock beklemeden bütün çıkışlar reset değerinde, spi_cs_n = '1'." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="680" width="260" height="150" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;AD7923 frame&lt;/b&gt; = 7 komutluk paket&lt;br&gt;CONFIG clk_div, CONFIG mode, CONFIG word length, CS on, TRANSFER (16 bit R/W), CS off, SYNC(id).&lt;br&gt;CS low 1,12 us; frame 1,3 us; CS düşen kenarları arası &amp;gt;= 5 us." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="845" width="260" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2 - ad7923_drv"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="ad7923_drv: iç bloklar" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Bütün register'lar rst_n ile async reset'li (reset değerleri 0 / ST_IDLE / PK_IDLE). Soft clear'lar (fifo_clr, per_rst, frm_launch, ST_PWR_WAIT dışı) senkron." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Kontrol girişleri&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;start, stop&lt;br&gt;continuous&lt;br&gt;ch_mask[3:0]&lt;br&gt;period_us[15:0]&lt;br&gt;range_sel, coding_sel&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="180" height="120" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Sonuç çıkışları&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;data_valid, data_ch[1:0]&lt;br&gt;data[11:0], data_last&lt;br&gt;busy, err&lt;/font&gt;' style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="180" height="100" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;spi_exec&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;(SPI master)&lt;br&gt;&lt;br&gt;komut / sdo /&lt;br&gt;sdi / sync&lt;br&gt;valid-ready&lt;br&gt;stream&amp;#x27;leri&lt;/font&gt;' style="rounded=0;fillColor=#b0e3e6;strokeColor=#0e8088;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="260" width="120" height="600" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Channel selector (comb)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;first_ch(mask_cur) -&amp;gt; sel_first&lt;br&gt;next_ch(mask_cur, cur_ch) -&amp;gt; sel_next, sel_last&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#fff5e6;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="90" width="320" height="80" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Control FSM  (p_ctrl)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;state: ST_IDLE ... ST_CORE_RST (sayfa 3)&lt;br&gt;mask_cur, period_cur, cur_ch&lt;br&gt;chip_sel, chip_sel_vld, pwr_done&lt;br&gt;stop_pend, err_r, err_scan, err_cnt&lt;br&gt;rst_cnt, core_rst_r&lt;br&gt;&lt;br&gt;frame isteği: frm_go, frm_pend, frm_dummy,&lt;br&gt;frm_disc, frm_wch, frm_ech, frm_last,&lt;br&gt;frm_derr&lt;br&gt;&lt;br&gt;çıkışlar: busy, err, core_rst, fifo_clr,&lt;br&gt;per_rst&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="260" width="320" height="320" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Timer'lar&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="660" width="320" height="200" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;p_cyc: cycle timer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;launch&amp;#x27;ta 0; 500 clk (5 us) -&amp;gt; cyc_ok&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="690" width="290" height="46" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;p_pwr: power-up timer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;ST_PWR_WAIT&amp;#x27;te 100 clk (1 us) -&amp;gt; pwr_ok&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="744" width="290" height="46" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;p_per: period timer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;us prescaler + us sayacı -&amp;gt; per_ok&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="798" width="290" height="46" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;struct_err (comb)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;to_hit or sync_err or fifo_unf&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#fff5e6;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="320" height="70" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Command packer  (p_pack)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;pk_st: PK_IDLE / PK_CMD / PK_WAIT&lt;br&gt;pk_idx 0..6, pk_dummy, pk_wch&lt;br&gt;sync_id (frame başına + 1)&lt;br&gt;sdo_r, sdo_valid_r (launch&amp;#x27;ta kurulur)&lt;br&gt;to_cnt: SYNC timeout (1000 clk) -&amp;gt; to_hit&lt;br&gt;&lt;br&gt;comb: cmd_i mux (7 komut), cmd_valid_i,&lt;br&gt;cmd_hs, frm_launch, frm_done, sync_err,&lt;br&gt;frm_cancel, pk_launched, req&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="260" width="320" height="320" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Expectation FIFO  (p_fifo)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;2 kayıt: {frm_last, frm_disc, frm_ech}&lt;br&gt;push: frm_launch, pop: sdi_valid&lt;br&gt;fifo_clr: senkron temizleme&lt;br&gt;çıkış: exp_last, exp_disc, exp_ch&lt;br&gt;fifo_unf: FIFO boşken sdi_valid&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="660" width="320" height="160" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;RX checker (comb)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;rx_take = sdi_valid and&lt;br&gt;not exp_disc&lt;br&gt;rx_lead_ok: sdi_data[15:14] = &amp;quot;00&amp;quot;&lt;br&gt;rx_addr_ok: sdi_data[13:12] = exp_ch&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#fff5e6;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="660" width="280" height="110" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Output register  (p_out)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;data_valid_r, data_ch_r, data_r,&lt;br&gt;data_last_r&lt;br&gt;rx_err_p (format / adres hatası, 1 clk)&lt;/font&gt;' style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="880" width="280" height="90" as="geometry"/></mxCell><mxCell id="c17" value="start, stop&lt;br&gt;continuous&lt;br&gt;ch_mask&lt;br&gt;period_us" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.2188;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c7"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="range_sel, coding_sel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;e