nd = 0 iken veya frm_cancel (launch öncesi) ile; launch olmuş frame SYNC'e kadar tamamlanır.&lt;br&gt;&lt;b&gt;Frame isteği:&lt;/b&gt; frm_pend = 0: frm_go + parametreler; frm_pend = 1: frm_done veya frm_cancel beklenir.&lt;br&gt;&lt;b&gt;ST_SCAN_END:&lt;/b&gt; err_scan ise err_cnt + 1, değilse 0; err_cnt = ERR_LIMIT - 1 iken hatalı tarama: pwr_done &lt;= 0, ST_IDLE. Yeni mask / period burada örneklenir." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="830" width="520" height="200" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Command packer FSM (p_pack)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="120" width="400" height="24" as="geometry"/></mxCell><mxCell id="c29" value="PK_IDLE" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="200" width="170" height="56" as="geometry"/></mxCell><mxCell id="c30" value="PK_CMD" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="420" width="170" height="56" as="geometry"/></mxCell><mxCell id="c31" value="PK_WAIT" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="640" width="170" height="56" as="geometry"/></mxCell><mxCell id="c32" value="frm_go" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.3529;exitY=1.0;exitDx=0;exitDy=0;entryX=0.3529;entryY=0.0;entryDx=0;entryD